# ─── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ─── AWS / Cognito ─────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── MongoDB ───────────────────────────────────────────────────────────────────
# Local development:
MONGO_URI=mongodb://127.0.0.1:27017/cloud-notes
#
# Production (MongoDB Atlas):
# Replace the placeholder below with the URI copied from Atlas:
#   Atlas Dashboard → Database → Connect → Drivers → Copy the connection string
#   Substitute <db_password> with your Atlas database user password.
# MONGO_URI=mongodb+srv://<username>:<db_password>@cluster0.xxxxx.mongodb.net/cloud-notes?retryWrites=true&w=majority

# ─── Redis / ElastiCache ───────────────────────────────────────────────────────
#
# Local development — caching disabled, no Redis server needed:
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_TLS=false
CACHE_TTL_SECONDS=60
#
# Production on EC2 (AWS ElastiCache, TLS on, no AUTH token):
# REDIS_ENABLED=true
# REDIS_HOST=master.cloud-notes-cache.24fns6.use1.cache.amazonaws.com
# REDIS_PORT=6379
# REDIS_TLS=true
# CACHE_TTL_SECONDS=60
# (do not set REDIS_PASSWORD — this cluster has no AUTH token configured)
